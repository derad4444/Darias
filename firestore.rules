rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザー認証が必要な個人データ
    match /users/{userId} {
      // フレンド機能のため、userId を指定した単体取得のみ認証済みユーザーに許可する
      // （QRコード・共有リンクからのフレンド追加で name / character_id を参照する）
      //
      // list（コレクション一覧取得）は禁止。許可すると認証済みの第三者が
      // 全ユーザーの name / email を一括取得できてしまう。
      // フレンド検索は Cloud Function `searchUsers` 経由で行うため、
      // クライアントが users を list する必要はない。
      allow get: if request.auth != null;
      allow list: if false;

      // ユーザー自身は書き込み可能
      allow write: if request.auth != null && request.auth.uid == userId;

      // キャラクター詳細（フレンドのアバター表示用）- 単体取得のみ許可
      // 夢はユーザーが自由入力できるため、ここではなく本人限定の
      // characters/{characterId}/dream/current に保存する
      match /characters/{characterId}/details/{detailId} {
        allow get: if request.auth != null;
        allow list: if false;
      }

      // ユーザーのサブコレクション（予定、日記、夢など）はユーザー自身のみ
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 祝日データ - 全ユーザーが読み取り可能、書き込みは管理者のみ
    match /holidays/{holidayId} {
      allow read: if true;
      allow write: if false; // 管理者による手動更新のみ
    }

    // システム設定 - 読み取り専用
    match /system/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Big5性格解析データ - 認証済みユーザーは読み取り可能、書き込みは不可（Cloud Functionのみ）
    match /Big5Analysis/{personalityKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 性格ごとのキャラクター属性テンプレート - Cloud Function 専用（Admin SDKはルールを迂回する）
    // 各ユーザーには details/current と dream/current にコピーされるため、
    // クライアントがこのコレクションを直接読む必要はない
    match /CharacterDetailsTemplate/{personalityKey} {
      allow read, write: if false;
    }

    // お問い合わせ - 認証済みユーザーは作成可能
    match /contacts/{contactId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false; // 読み取り・更新・削除は不可（Cloud Functionとコンソールのみ）
    }

    // 共有会議データ - 認証済みユーザーは読み取り可能、書き込みは不可（Cloud Functionのみ）
    match /shared_meetings/{meetingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 広告分析データ - 認証済みユーザーは書き込み可能、読み取りは不可
    match /ad_analytics/{analyticsId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // 手帳タブ廃止アンケート（匿名回答）- 認証済みユーザーは作成のみ可能
    // 読み取り・更新・削除はコンソール/管理SDKのみ
    match /techou_survey_responses/{responseId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // 全ての他のドキュメントはアクセス拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}